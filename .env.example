# Local development
PORT=2000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=

# Comma-separated frontend origins for CORS + Socket.IO (required in production)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app,https://your-app-git-main.vercel.app
CLIENT_URL=http://localhost:3000

# Optional alias for CLIENT_URL (same format, comma-separated)
# FRONTEND_URL=

# Bind address (Render sets PORT automatically; 0.0.0.0 is required for cloud hosts)
HOST=0.0.0.0

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (from Apple Developer)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Use \n for line breaks when storing the .p8 key in a single env var
APPLE_PRIVATE_KEY=

# --- Production (Render) ---
# NODE_ENV=production
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/healthaid?retryWrites=true&w=majority
# JWT_SECRET=<long-random-string>
# CLIENT_URL=https://your-app.vercel.app
